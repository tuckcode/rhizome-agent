# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
site/.vitepress/cache/
site/.vitepress/dist/
_site/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# Same shape as .vscode above: per-machine state (hook counters, timestamps)
# is ignored, but a shared .cursor/rules/ can still be committed if the repo
# ever wants one.
.cursor/*
!.cursor/rules/
!.cursor/skills/
.cursor/skills/*
!.cursor/skills/rhizome-ship/
!.cursor/skills/rhizome-ship/**
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright
/test-results/
/playwright-report/

# Coverage reports
/coverage/

# Demo vault and helper scripts
demo-vault/
generated-fixtures/
select_demo_notes*.py
final_selection.py

# Claude Code task signals
.claude-done
.claude-blocked
src-tauri/target

# Generated mcp-server bundle (built by scripts/bundle-mcp-server.mjs)
src-tauri/resources/mcp-server/

# Python cache
__pycache__/
*.py[cod]

# Dev screenshots
screenshots/

# Stale planning docs (keep locally if needed, not in repo)
REDESIGN-PLAN.md
SF-SYMBOLS-MIGRATION.md
CODE-HEALTH-REPORT.md

# Local home dir artifact from worktree ops
(HOME)/

# Personal agent-skill tooling (npx skills@latest), not app source
.agents/
.claude/skills/
# Machine-local Claude settings (hardcoded paths). Global ignore may miss
# worktrees, cursor/* branches, and bridge VMs that do not mount ~/.config/git.
.claude/settings.local.json
agent/
skills-lock.json

# Runtime / process files
.claude-pid

# Generated vault index files (qmd/search artifacts)
.laputa-index.json

# Tauri signing keys (never commit private keys)
*.key
*.key.pub

# Local environment variables (never commit)
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
!.env.example
!.env.*.example

# Local Codacy CLI runtime/config generated by the MCP server
.codacy/

# DeepSec scanner runtime/config — holds .env.local. Lives at ~/deepsec-scan
# now, but this repo is public; ignore it so a stray re-init can't be staged.
.deepsec/

# Rhizome Agent — never treat as Desktop satellite
.claude/worktrees/
.worktrees/

# Stray sibling directories that land in the repo root — a Claude Code
# session dump (multi-MB transcript) and a separate git repo. Neither
# belongs in this history; both were committed by accident once (C43).
rhizome-agent-claude-session/
rhizome-agent-design-system/
rhizome-agent/

# Audit evidence (screenshots, measurements, probe scripts) stays local.
# The repository is public; reports note the evidence is not committed.
docs/design/*-ui-audit/
