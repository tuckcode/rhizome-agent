#!/bin/sh
# Pre-push: full CI checks run locally before any push.
# This replaces remote CI for normal task pushes.
# DO NOT skip with --no-verify (Claude Code is configured to never do this).
#
# ── Optimizations (Feb 2026) ─────────────────────────────────────────────
#
# 1. --no-clean on cargo llvm-cov: reuses previous instrumented build
#    artifacts for incremental compilation. Reduces Rust coverage from
#    ~8 min (full recompile) to ~30-60s (incremental rebuild).
#
# 2. Change detection: skips Rust checks entirely when no files under
#    src-tauri/ changed. Saves ~1-2 min on frontend-only pushes.
#
# 3. Merged redundant test runs: frontend coverage (step 2) already runs
#    all tests, so the separate test step was removed.
#
# 4. Fast-fail ordering: within Rust checks, fast lints (fmt ~2s, clippy
#    ~15s) run before slow coverage (~30-60s) for quicker feedback.
#
# 5. Force full coverage: set LAPUTA_FULL_COVERAGE=1 to run cargo llvm-cov
#    without --no-clean (clean rebuild, accurate baseline).
#
# Expected times (warm cache, incremental):
#   Frontend only:  ~1 min
#   Frontend+Rust:  ~2-3 min
#   Full coverage:  ~9-10 min (with LAPUTA_FULL_COVERAGE=1)
# ─────────────────────────────────────────────────────────────────────────
set -e

ensure_cargo_tooling() {
  if command -v cargo >/dev/null 2>&1; then
    return 0
  fi

  if [ -s "$HOME/.cargo/env" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.cargo/env"
  fi

  if ! command -v cargo >/dev/null 2>&1; then
    echo "❌ cargo must be available before pushing"
    echo "   Install Rust via https://rustup.rs or ensure ~/.cargo/bin is in PATH."
    exit 1
  fi
}

ensure_llvm_coverage_tooling() {
  # `cargo llvm-cov` needs llvm-cov and llvm-profdata. rustup's
  # llvm-tools-preview supplies them on its own, which is the Windows and
  # Linux path and needs nothing here. macOS installs LLVM through Homebrew,
  # where cargo cannot find them unless the two variables point at it.
  #
  # AGENTS.md documented exporting these by hand before every push. That is a
  # ritual a hook can perform for itself, and forgetting it costs a full
  # re-run of every other gate — which is exactly what happened on
  # 2026-08-22.
  if [ -n "$LLVM_COV" ] && [ -n "$LLVM_PROFDATA" ]; then
    return 0
  fi
  if command -v brew >/dev/null 2>&1; then
    BREW_LLVM="$(brew --prefix llvm 2>/dev/null)"
    if [ -x "$BREW_LLVM/bin/llvm-cov" ] && [ -x "$BREW_LLVM/bin/llvm-profdata" ]; then
      export LLVM_COV="$BREW_LLVM/bin/llvm-cov"
      export LLVM_PROFDATA="$BREW_LLVM/bin/llvm-profdata"
      return 0
    fi
  fi

  # Homebrew's llvm is not guaranteed. `brew --prefix llvm` answers with a
  # path whether or not the formula is installed, so the old check passed the
  # prefix test and then failed inside cargo with "could not execute process
  # … No such file or directory" — an error that names llvm-profdata and not
  # the reason. Observed 2026-08-28 on a machine where the formula had gone
  # while `/opt/homebrew/opt/llvm` remained.
  #
  # Xcode Command Line Tools ship both, and every macOS machine that can
  # compile this project already has them. Rust here is Homebrew's rather than
  # rustup's, so `llvm-tools-preview` is not an option to fall back to.
  XCODE_LLVM="/Library/Developer/CommandLineTools/usr/bin"
  if [ -x "$XCODE_LLVM/llvm-cov" ] && [ -x "$XCODE_LLVM/llvm-profdata" ]; then
    export LLVM_COV="$XCODE_LLVM/llvm-cov"
    export LLVM_PROFDATA="$XCODE_LLVM/llvm-profdata"
  fi
}

ensure_playwright_browser() {
  # A missing browser binary does not fail loudly — every spec dies in about a
  # millisecond inside browserType.launch, so the lane reports twenty-six
  # failures that look like the change under test broke everything. Checking
  # first turns that into one line.
  #
  # Playwright pins a browser build per version, so a version bump orphans the
  # cached binary. That happened on 2026-08-22 between two pushes an hour
  # apart, with no change to any test.
  if npx --no-install playwright install --dry-run chromium >/dev/null 2>&1; then
    if ! npx --no-install playwright install chromium >/dev/null 2>&1; then
      echo "  ⚠️  playwright browser install failed — run: npx playwright install chromium"
    fi
  fi
}

ensure_node_tooling() {
  if command -v node >/dev/null 2>&1 && command -v pnpm >/dev/null 2>&1; then
    return 0
  fi

  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1090
    . "$NVM_DIR/nvm.sh" --no-use
    nvm use --silent node >/dev/null 2>&1 || true
  fi

  if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
    echo "❌ node and pnpm must be available before pushing"
    echo "   Install them or make sure your nvm setup is available to git hooks."
    exit 1
  fi
}

# A `prototype/*` branch is throwaway code kept as a primary source: the
# measurement or spike that settled a decision, parked out of main so the
# number can be re-run later instead of re-derived. It never merges, so the
# main-only rule does not need to cover it — and the full gate suite does not
# either, since prototype code is written without tests or error handling by
# design. See `docs/adr/` and the `prototype` skill.
IS_PROTOTYPE_BRANCH=false

require_main_push() {
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
  case "$CURRENT_BRANCH" in
    prototype/*)
      IS_PROTOTYPE_BRANCH=true
      ;;
    main | HEAD)
      ;;
    *)
      echo "❌ Pushes must happen from main, a detached HEAD pushed directly to main, or a prototype/* branch. Current branch: $CURRENT_BRANCH"
      exit 1
      ;;
  esac

  while IFS=' ' read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    [ -z "$LOCAL_REF" ] && continue

    case "$LOCAL_REF:$REMOTE_REF" in
      refs/heads/main:refs/heads/main)
        ;;
      HEAD:refs/heads/main)
        ;;
      refs/tags/*:refs/tags/*)
        ;;
      refs/heads/prototype/*:refs/heads/prototype/*)
        ;;
      *)
        echo "❌ Pushes must be main -> main, a tag, or prototype/* -> the same prototype/*."
        echo "   Attempted: ${LOCAL_REF:-<none>} -> ${REMOTE_REF:-<none>}"
        exit 1
        ;;
    esac
  done <<EOF
$PUSH_INPUT
EOF
}

if [ -t 0 ]; then
  PUSH_INPUT=""
else
  PUSH_INPUT=$(cat)
fi
require_main_push

if [ "$IS_PROTOTYPE_BRANCH" = true ]; then
  echo ""
  echo "🧪 prototype branch — gates skipped by design."
  echo "   Throwaway code parked as a primary source; it never merges to main."
  exit 0
fi

ensure_node_tooling

START_TIME=$(date +%s)

echo ""
echo "🚀 Pre-push checks (replaces CI — do not skip)"
echo "================================================"

# ── Detect what changed ─────────────────────────────────────────────────
PUSH_TARGET=$(git rev-parse @{push} 2>/dev/null || echo "")
RUST_CHANGED=true
APP_CHANGED=true
SITE_CHANGED=false

if [ -n "$PUSH_TARGET" ]; then
  CHANGED=$(git diff --name-only "$PUSH_TARGET"..HEAD)
  APP_CHANGED=false
  if ! echo "$CHANGED" | grep -qE '^(src-tauri/|Cargo)'; then
    RUST_CHANGED=false
  fi
  for FILE in $CHANGED; do
    case "$FILE" in
      site/*)
        SITE_CHANGED=true
        ;;
      .github/workflows/*|.husky/*|docs/*|*.md)
        ;;
      *)
        APP_CHANGED=true
        ;;
    esac
  done
fi

if [ "$APP_CHANGED" = false ]; then
  if [ "$SITE_CHANGED" = true ]; then
    echo ""
    echo "📚 Docs-only push detected; running docs build..."
    pnpm docs:build
    echo "  ✅ Docs build OK"
  else
    echo ""
    echo "⏭️  App checks skipped (docs/workflow/hooks only)"
  fi
  ELAPSED=$(($(date +%s) - START_TIME))
  echo ""
  echo "✅ Pre-push passed in ${ELAPSED}s"
  exit 0
fi

run_sidecar_automatic_checks() {
  if [ "${LAPUTA_PREPUSH_LOCAL:-0}" = "1" ]; then
    echo "☁️  Chunk sidecar checks disabled by LAPUTA_PREPUSH_LOCAL=1"
    return 1
  fi

  if ! command -v bash >/dev/null 2>&1; then
    echo "☁️  bash not found; falling back to local automatic checks"
    return 1
  fi

  echo ""
  echo "☁️  Running automatic checks on Chunk sidecar..."
  if bash .chunk/run-sidecar-gates-local.sh "$RUST_CHANGED"; then
    echo "  ✅ Chunk sidecar automatic checks OK"
    return 0
  else
    SIDECAR_STATUS=$?
  fi

  if [ "$SIDECAR_STATUS" -eq 86 ]; then
    echo "  ⚠️  Chunk sidecar unavailable; falling back to local automatic checks"
    return 1
  fi

  echo "  ❌ Chunk sidecar automatic checks FAILED"
  exit "$SIDECAR_STATUS"
}

# ── Local fallback: three lanes, run together ─────────────────────────────
#
# The sidecar path exists so these do not run on the developer's laptop at
# all. When it is unavailable they do, and running them one after another
# costs ~4.5 minutes a push (measured 2026-08-21) for gates that barely touch
# each other: the frontend lane does not need cargo, the Rust lane does not
# need vite, and Playwright waits on a browser more than on a CPU.
#
# So the fallback runs them concurrently and reports per lane. Output is
# captured rather than interleaved — three streams racing into one terminal is
# unreadable, and the only output that matters is the failing lane's, which is
# printed in full.
#
# `LAPUTA_PREPUSH_SERIAL=1` restores the old one-at-a-time behaviour for a
# machine where the contention is worse than the wait.
run_lane() {
  local name="$1"
  local log="$2"
  shift 2

  if bash -c "$*" >"$log" 2>&1; then
    return 0
  fi
  return 1
}

report_lane_failure() {
  local name="$1"
  local log="$2"

  echo ""
  echo "❌ ${name} lane FAILED — its output follows:"
  echo "────────────────────────────────────────────────────────"
  cat "$log"
  echo "────────────────────────────────────────────────────────"
}

if ! run_sidecar_automatic_checks; then
  ensure_cargo_tooling
  ensure_llvm_coverage_tooling
  ensure_playwright_browser

  LANE_LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/rhizome-prepush.XXXXXX")"
  trap 'rm -rf "$LANE_LOG_DIR"' EXIT

  # Coverage was pinned to one shard at a time, which was most of this lane:
  # measured 2026-08-21, concurrency 1 took 124s and 2 took 85s. The runner
  # defaults concurrency to the shard count, so the pin is simply removed
  # rather than replaced with another number. Four shards measured no better
  # than two — a fixed cost (vitest startup, instrumentation, merging)
  # dominates from there.
  FRONTEND_LANE="pnpm lint && pnpm build && node scripts/run-vitest-coverage-shards.mjs --silent && pnpm test:mcp"

  # Unset GIT_DIR so git tests create isolated repos without inheriting hook
  # context. `--no-clean` keeps the incremental build; LAPUTA_FULL_COVERAGE=1
  # forces a clean one.
  RUST_COV_FLAGS="--no-clean"
  if [ "${LAPUTA_FULL_COVERAGE:-0}" = "1" ]; then
    RUST_COV_FLAGS=""
  fi
  RUST_LANE="unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; cargo clippy --manifest-path=src-tauri/Cargo.toml -- -D warnings && cargo fmt --manifest-path=src-tauri/Cargo.toml -- --check && cargo llvm-cov --manifest-path src-tauri/Cargo.toml ${RUST_COV_FLAGS} --ignore-filename-regex \"lib\\.rs|main\\.rs|menu\\.rs\" --fail-under-lines 85 -- --test-threads=1"

  SMOKE_FILES=$(find tests/smoke tests/integration -name '*.spec.ts' 2>/dev/null | head -1)
  PLAYWRIGHT_LANE="pnpm playwright:smoke"

  if [ "${LAPUTA_PREPUSH_SERIAL:-0}" = "1" ]; then
    echo ""
    echo "🐌 Running gates serially (LAPUTA_PREPUSH_SERIAL=1)"
    LANE_MODE="serial"
  else
    echo ""
    echo "⚡ Running frontend, Rust and Playwright lanes together"
    LANE_MODE="parallel"
  fi

  FRONTEND_LOG="$LANE_LOG_DIR/frontend.log"
  RUST_LOG="$LANE_LOG_DIR/rust.log"
  PLAYWRIGHT_LOG="$LANE_LOG_DIR/playwright.log"
  FRONTEND_PID=""
  RUST_PID=""
  PLAYWRIGHT_PID=""
  LANE_FAILED=""

  # Started here rather than from a helper: a background job launched inside a
  # command substitution is a grandchild of this shell, and `wait` only knows
  # about its own children. The first version of this did exactly that and
  # would have failed the moment a lane finished.
  if [ "$LANE_MODE" = "serial" ]; then
    echo "  ▶ frontend (lint, build, coverage, mcp)"
    run_lane frontend "$FRONTEND_LOG" "$FRONTEND_LANE" \
      || { report_lane_failure frontend "$FRONTEND_LOG"; exit 1; }
    echo "  ✅ frontend OK"

    if [ "$RUST_CHANGED" = true ]; then
      echo "  ▶ rust (clippy, fmt, coverage ≥85%)"
      run_lane rust "$RUST_LOG" "$RUST_LANE" \
        || { report_lane_failure rust "$RUST_LOG"; exit 1; }
      echo "  ✅ rust OK"
    else
      echo "  ⏭️  rust — skipped (no src-tauri/ changes)"
    fi

    if [ -n "$SMOKE_FILES" ]; then
      echo "  ▶ playwright (core smoke)"
      run_lane playwright "$PLAYWRIGHT_LOG" "$PLAYWRIGHT_LANE" \
        || { report_lane_failure playwright "$PLAYWRIGHT_LOG"; exit 1; }
      echo "  ✅ playwright OK"
    else
      echo "  ⏭️  playwright — skipped (no tests/**/*.spec.ts)"
    fi
  else
    echo "  ▶ frontend (lint, build, coverage, mcp)"
    run_lane frontend "$FRONTEND_LOG" "$FRONTEND_LANE" &
    FRONTEND_PID=$!

    if [ "$RUST_CHANGED" = true ]; then
      echo "  ▶ rust (clippy, fmt, coverage ≥85%)"
      run_lane rust "$RUST_LOG" "$RUST_LANE" &
      RUST_PID=$!
    else
      echo "  ⏭️  rust — skipped (no src-tauri/ changes)"
    fi

    if [ -n "$SMOKE_FILES" ]; then
      echo "  ▶ playwright (core smoke)"
      run_lane playwright "$PLAYWRIGHT_LOG" "$PLAYWRIGHT_LANE" &
      PLAYWRIGHT_PID=$!
    else
      echo "  ⏭️  playwright — skipped (no tests/**/*.spec.ts)"
    fi

    # Every lane is waited on before deciding, so one failure does not hide
    # another and no lane is left running after the hook returns.
    if [ -n "$FRONTEND_PID" ] && ! wait "$FRONTEND_PID"; then
      report_lane_failure frontend "$FRONTEND_LOG"
      LANE_FAILED="yes"
    fi
    if [ -n "$RUST_PID" ] && ! wait "$RUST_PID"; then
      report_lane_failure rust "$RUST_LOG"
      LANE_FAILED="yes"
    fi
    if [ -n "$PLAYWRIGHT_PID" ] && ! wait "$PLAYWRIGHT_PID"; then
      report_lane_failure playwright "$PLAYWRIGHT_LOG"
      LANE_FAILED="yes"
    fi

    if [ -n "$LANE_FAILED" ]; then
      exit 1
    fi
    echo "  ✅ All lanes OK"
  fi
fi

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))
MINUTES=$((ELAPSED / 60))
SECONDS=$((ELAPSED % 60))

echo ""
echo "================================================"
echo "✅ All checks passed — pushing (${MINUTES}m ${SECONDS}s)"
echo ""
